# ─────────────────────────────────────────────────────────────
# Colossus Gateway — Environment Variables
# Copy to .env and fill in values before running locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Pinecone (vector / semantic memory) ───────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=colossus-apex
PINECONE_ENVIRONMENT=us-east-1
PINECONE_EMBED_DIM=1536

# ── Supermemory (structured / conversational memory) ──────────
SUPERMEMORY_API_KEY=
SUPERMEMORY_SPACE_OPS=
SUPERMEMORY_SPACE_SCENARIOS=
SUPERMEMORY_SPACE_LEGAL=
SUPERMEMORY_SPACE_DOCS=

# ── xai-colossus-energy ───────────────────────────────────────
ENERGY_GRID_LIMIT_MW=1100
ENERGY_FEEDER_COUNT=8
ENERGY_ALERT_THRESHOLD_PCT=0.90

# ── xai-colossus-servers ──────────────────────────────────────
SERVERS_RACK_COUNT=32
SERVERS_GPU_PER_RACK=8
SERVERS_TDP_PER_GPU_W=700

# ── xai-colossus-cooling ──────────────────────────────────────
COOLING_INLET_TEMP_MAX_C=27
COOLING_DELTA_T_TARGET_C=15
COOLING_WATER_LIMIT_GPM=5000

# ── xai-colossus-security ─────────────────────────────────────
SECURITY_AUDIT_LOG_PATH=./logs/audit.jsonl
SECURITY_ALERT_WEBHOOK=

# ── DOCTOR-STRANGE / APEX ─────────────────────────────────────
APEX_HEARTBEAT_INTERVAL_S=60
APEX_GAP_SCAN_INTERVAL_S=300
APEX_SWARM_MAX_WORKERS=8
