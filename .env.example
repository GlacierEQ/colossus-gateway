# ────────────────────────────────────────────
# Colossus APEX — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ────────────────────────────────────────────

# ── Core Infrastructure ──────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── Version Control ───────────────────────────
GITHUB_TOKEN=ghp_your_token

# ── Knowledge & Docs ──────────────────────────
NOTION_API_KEY=secret_your_notion_integration_key

# ── Deployment ────────────────────────────────
VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=prj_your_project_id

# ── Analytics Warehouse ───────────────────────
MOTHERDUCK_TOKEN=your_motherduck_token

# ── Project Management ────────────────────────
CLICKUP_API_KEY=your_clickup_api_key
CLICKUP_TEAM_ID=your_team_id
CLICKUP_LIST_ID_P1=your_p1_list_id
CLICKUP_LIST_ID_EJ=your_ej_list_id

# ── Stakeholder & Permitting ──────────────────
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=appYourBaseId

# ── Documents ─────────────────────────────────
# Shared token for Google Docs + Google Sheets
GOOGLE_OAUTH_TOKEN=ya29_your_oauth_token
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token

# Microsoft Graph (OneNote)
MICROSOFT_GRAPH_TOKEN=your_graph_access_token
MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_CLIENT_SECRET=your_client_secret
MICROSOFT_TENANT_ID=your_tenant_id

# ── Vector Memory ─────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=colossus-apex
PINECONE_ENVIRONMENT=us-east-1
PINECONE_EMBED_DIM=1536

QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=colossus

# Supermemory.ai (contextual agent memory)
SUPERMEMORY_API_KEY=your_supermemory_api_key
SUPERMEMORY_SPACE_OPS=your_ops_space_id
SUPERMEMORY_SPACE_SCENARIOS=your_scenarios_space_id
SUPERMEMORY_SPACE_LEGAL=your_legal_space_id
SUPERMEMORY_SPACE_DOCS=your_docs_space_id

# ── Observability ─────────────────────────────
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_DSN=https://your_key@o123456.ingest.sentry.io/project_id
SENTRY_ORG=glaciereq
SENTRY_PROJECT=colossus-gateway
