# Colossus Gateway — runtime configuration. Never commit real values.

# Gateway authentication (required for MCP and memory routes)
COLOSSUS_OPERATOR_CODE=
COLOSSUS_OPERATOR_GUID=
# Legacy alias accepted for migration only:
COLOSSUS_TOOL_KEY=

# Composio v3 connector broker
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3
COMPOSIO_CONNECTED_ACCOUNT_ID=
COMPOSIO_USER_ID=
# Comma-separated exact tool slugs; do not use * in production.
COMPOSIO_ALLOWED_TOOLS=

# Memory middleware
MEM0_API_KEY=
MEM0_BASE_URL=https://api.mem0.ai
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai/v3

# Universal executor: comma-separated exact remote tool names.
COLOSSUS_ALLOWED_REMOTE_TOOLS=

# Existing connectors and audit logging
BOX_ACCESS_TOKEN=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
AUDIT_TABLE=apex_integration_events
CASE_ID=1FDV-23-0001009
NOTION_TOKEN=
NOTION_ACTION_PARENT_PAGE_ID=
PINECONE_API_KEY=
PINECONE_INDEX=colossus-apex
PINECONE_ENVIRONMENT=us-east-1
PINECONE_EMBED_DIM=1536
GITHUB_TOKEN=

# Operational defaults
ENERGY_GRID_LIMIT_MW=1100
ENERGY_FEEDER_COUNT=8
ENERGY_ALERT_THRESHOLD_PCT=0.90
SERVERS_RACK_COUNT=32
SERVERS_GPU_PER_RACK=8
SERVERS_TDP_PER_GPU_W=700
COOLING_INLET_TEMP_MAX_C=27
COOLING_DELTA_T_TARGET_C=15
COOLING_WATER_LIMIT_GPM=5000
SECURITY_AUDIT_LOG_PATH=./logs/audit.jsonl
SECURITY_ALERT_WEBHOOK=
APEX_HEARTBEAT_INTERVAL_S=60
APEX_GAP_SCAN_INTERVAL_S=300
APEX_SWARM_MAX_WORKERS=8
