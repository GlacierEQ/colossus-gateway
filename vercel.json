{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/health.ts" },
    { "src": "/mcp", "dest": "/api/mcp.ts" },
    { "src": "/api/memory/add", "dest": "/api/memory/add.ts" },
    { "src": "/api/memory/search", "dest": "/api/memory/search.ts" },
    { "src": "/api/memory/delete", "dest": "/api/memory/delete.ts" },
    { "src": "/(.*)", "dest": "/api/mcp.ts" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
