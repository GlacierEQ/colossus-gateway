# GODMIND Colossus Gateway — Connector Environment Variables
# Copy relevant sections to your .env file.
# Never commit this file with real values.

# ── Google Photos ────────────────────────────────────────────────────────────
# OAuth2 setup: https://console.cloud.google.com → APIs → Photos Library API
# Scopes needed: https://www.googleapis.com/auth/photoslibrary.readonly
GOOGLE_PHOTOS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_PHOTOS_CLIENT_SECRET=your_client_secret
GOOGLE_PHOTOS_REFRESH_TOKEN=your_refresh_token
# GOOGLE_PHOTOS_ACCESS_TOKEN=  # optional — auto-refreshed

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Fine-grained PAT: https://github.com/settings/tokens
# Scopes: repo, read:user
GITHUB_TOKEN=ghp_your_token
GITHUB_DEFAULT_OWNER=GlacierEQ
GITHUB_DEFAULT_REPO=colossus-gateway

# ── Notion ─────────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_your_integration_token
NOTION_CASES_DB=your_cases_database_id
NOTION_EVIDENCE_DB=your_evidence_database_id
NOTION_DEFAULT_DB=your_default_database_id

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=colossus
PINECONE_NAMESPACE=cases
PINECONE_REGION=us-east-1

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_cloud
QDRANT_COLLECTION=colossus
QDRANT_VECTOR_SIZE=1536

# ── MotherDuck ───────────────────────────────────────────────────────────────
MOTHERDUCK_TOKEN=your_motherduck_token
MOTHERDUCK_DATABASE=colossus

# ── ClickUp ──────────────────────────────────────────────────────────────────
CLICKUP_API_TOKEN=pk_your_api_token
CLICKUP_WORKSPACE_ID=your_workspace_id
CLICKUP_CASE_LIST_ID=your_case_list_id
CLICKUP_EVIDENCE_LIST_ID=your_evidence_list_id

# ── Neon (Postgres) ───────────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → Connection Details → Connection string
NEON_CONNECTION_STRING=postgresql://user:pass@host.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=your_project_id

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=patYourPersonalAccessToken
AIRTABLE_BASE_ID=appYourBaseId
AIRTABLE_CASE_TABLE=Cases
AIRTABLE_EVIDENCE_TABLE=Evidence
AIRTABLE_TIMELINE_TABLE=Timeline

# ── OneDrive (Microsoft Graph) ──────────────────────────────────────────────────────
# App registration: https://portal.azure.com → App registrations
# Scopes: Files.ReadWrite, offline_access
ONEDRIVE_CLIENT_ID=your_azure_app_client_id
ONEDRIVE_CLIENT_SECRET=your_azure_app_secret
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REFRESH_TOKEN=your_refresh_token
ONEDRIVE_ROOT_FOLDER=/colossus-cases

# ── Dropbox ────────────────────────────────────────────────────────────────────
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_ROOT_PATH=/colossus-cases

# ── Bridge ──────────────────────────────────────────────────────────────────────
BRIDGE_PORT=7700
CASES_ROOT=./cases
COLOSSUS_BRIDGE_TOKEN=change_me_before_running
