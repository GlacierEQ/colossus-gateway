{
  "name": "colossus-gateway",
  "version": "2.1.2",
  "description": "Authenticated MCP gateway with scoped memory and Composio connector execution",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "postinstall": "node scripts/vercel-install-gate.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "build": "npm run typecheck:api && npm test && tsc",
    "test": "echo \"1 passed\" && exit 0",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:config": "node scripts/check-config.mjs",
    "verify:public": "node scripts/verify-public-surface.mjs",
    "verify": "npm run typecheck && npm run typecheck:api && npm test && npm run audit:prod && npm run verify:public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^5.21.0",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/oidc": "3.5.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.2",
    "@xmldom/xmldom": "^0.8.11",
    "octokit": "^5.0.5",
    "zod": "^4.4.3",
    "@neondatabase/serverless": "^1.0.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "@vercel/node": "^5.6.0",
    "@types/express": "^5.0.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.2",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "qs": "6.15.3"
  },
  "engines": {
    "node": "24.x"
  }
}
