{
  "name": "colossus-gateway",
  "version": "2.1.2",
  "description": "Authenticated MCP gateway with scoped memory and Composio connector execution",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "build": "npm run typecheck:api && npm run test:runtime && tsc",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:config": "node scripts/check-config.mjs",
    "verify:public": "node scripts/verify-public-surface.mjs",
    "verify": "npm run typecheck && npm run typecheck:api && npm test && npm run audit:prod && npm run verify:public",
    "test:owned": "vitest run tests/ownedInvocation.test.ts",
    "test:runtime": "vitest run tests/ownedInvocation.test.ts tests/memoryRouter.test.ts tests/boxBridge.test.ts tests/boxKeymasterAuth.test.ts tests/remoteEvidenceGate.test.ts tests/notionConnectIdentity.test.ts tests/gatewayAuthorityBroker.test.ts",
    "verify:deployment": "node scripts/vercel-install-gate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^5.21.0",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/oidc": "3.5.0",
    "axios": "1.20.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.2",
    "@xmldom/xmldom": "^0.8.15",
    "octokit": "^5.0.5",
    "zod": "^4.4.3",
    "@neondatabase/serverless": "^1.0.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "@vercel/node": "^5.10.2",
    "@types/express": "^5.0.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "4.2.1",
    "form-data": "4.0.6",
    "hono": "4.13.10",
    "ip-address": "10.7.2",
    "qs": "6.16.0",
    "express-rate-limit": "8.7.0",
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": "24.x"
  }
}
